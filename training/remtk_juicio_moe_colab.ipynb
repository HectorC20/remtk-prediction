model_cpu = RemtkJuicioJEVMoE(**ACTIVE_CFG).cpu()
model_cpu.load_state_dict(model.cpu().state_dict())
model_cpu.eval()

# Tensores dummy en dimensión E5_EMBED_DIM (384) para coincidir con el encoder en producción
dummy_q = F.normalize(torch.randn(1, 24, ACTIVE_CFG["d_embed"]), p=2, dim=-1)
dummy_q[:, 18:, :] = 0.0
dummy_c = F.normalize(torch.randn(1, 32, ACTIVE_CFG["d_embed"]), p=2, dim=-1)
dummy_c[:, 24:, :] = 0.0
dummy_t = F.normalize(torch.randn(16, 28, ACTIVE_CFG["d_embed"]), p=2, dim=-1)
dummy_t[:, 20:, :] = 0.0

input_names = ["query_tokens", "context_tokens", "tools_tokens"]
output_names = [
