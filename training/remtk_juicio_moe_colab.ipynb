# ==============================================================================
# 2B. ARQUITECTURA MULTI-MODELO: MOTOR GENERATIVO DINÁMICO (QWEN TEACHER LLM)
# ==============================================================================
# En lugar de inyectar listas estáticas o plantillas fijas, un modelo generativo
# (Qwen2.5-3B-Instruct) sintetiza dinámicamente:
#   1. Herramientas abiertas de nuevos dominios (para evitar sobreajuste a las 174 base).
#   2. Consultas diversas, implícitas, coloquiales, multilingües y con ruido realista.
#   3. Turnos conversacionales previos (confirmaciones, correcciones con negación, dudas).
#   4. Escenarios de evaluación Zero-Shot completamente inéditos.
# ==============================================================================
TEACHER_LLM_NAME = os.environ.get("REMTK_TEACHER_MODEL", "Qwen/Qwen2.5-3B-Instruct")
DYNAMIC_CORPUS_CACHE_PATH = DATA_DIR / "dynamic_qwen_corpus_v2.json"

class QwenDynamicMultiModelSynthesizer:
    def __init__(self, model_name: str = TEACHER_LLM_NAME, device: torch.device = DEVICE):
        self.model_name = model_name
        self.device = device
        self.tokenizer = None
        self.model = None

    def load_teacher(self):
        if self.model is not None:
            return
        print(f"[Multi-Model Teacher] Cargando LLM generador dinámico: {self.model_name}...")
        self.tokenizer = AutoTokenizer.from_pretrained(self.model_name, padding_side="left")
        if self.tokenizer.pad_token is None:
            self.tokenizer.pad_token = self.tokenizer.eos_token
        dtype = torch.bfloat16 if (torch.cuda.is_available() and USE_BF16) else torch.float16
        self.model = AutoModelForCausalLM.from_pretrained(
            self.model_name,
            torch_dtype=dtype,
            device_map="auto" if torch.cuda.is_available() else None,
        ).eval()
        print("[Multi-Model Teacher] LLM cargado en GPU y listo para síntesis dinámica.")

    def unload_teacher(self):
        if self.model is not None:
            print("[Multi-Model Teacher] Liberando VRAM del Teacher LLM antes de entrenar el MoE 3.5B...")
            del self.model
            del self.tokenizer
            self.model = None
            self.tokenizer = None
            gc.collect()
            if torch.cuda.is_available():
                torch.cuda.empty_cache()

    @torch.inference_mode()
    def generate_json_batches(self, prompts: List[str], max_new_tokens: int = 384, temperature: float = 0.85, batch_size: int = 16) -> List[str]:
        self.load_teacher()
        outputs = []
        for start in range(0, len(prompts), batch_size):
            batch_prompts = prompts[start : start + batch_size]
            formatted = [
                self.tokenizer.apply_chat_template(
                    [
                        {"role": "system", "content": "You are a synthetic data generator for an AI tool-calling router. Always reply ONLY with valid JSON arrays. No markdown explanations."},
                        {"role": "user", "content": p},
                    ],
                    tokenize=False,
                    add_generation_prompt=True,
                )
                for p in batch_prompts
            ]
            enc = self.tokenizer(formatted, return_tensors="pt", padding=True, truncation=True, max_length=1024).to(self.device)
            gen_ids = self.model.generate(
                **enc,
                max_new_tokens=max_new_tokens,
                do_sample=True,
                temperature=temperature,
                top_p=0.92,
                pad_token_id=self.tokenizer.pad_token_id,
            )
            prompt_len = enc["input_ids"].shape[1]
            for i in range(len(batch_prompts)):
                raw_txt = self.tokenizer.decode(gen_ids[i, prompt_len:], skip_special_tokens=True).strip()
                outputs.append(raw_txt)
        return outputs

    @staticmethod
    def _extract_json_list(raw_text: str) -> List[Any]:
        start_idx = raw_text.find("[")
        end_idx = raw_text.rfind("]")
        if start_idx != -1 and end_idx != -1 and end_idx > start_idx:
            try:
                parsed = json.loads(raw_text[start_idx : end_idx + 1])
                if isinstance(parsed, list):
                    return parsed
            except Exception:
                pass
        return []

    def synthesize_open_world_tools(self, num_extra_tools: int = 48) -> Dict[str, Dict[str, Any]]:
        """
        Pide al Teacher LLM que invente herramientas completamente nuevas de dominios variados
        (IoT, Streaming, Viajes, Delivery, Blockchain, Diseño, Salud, Robótica, Git, IDE, etc.)
        para que la red aprenda a discriminar semánticamente sobre cualquier herramienta nueva.
        """
        domain_themes = [
            (0, "CRUD_ACTION", "e-commerce orders, hotel bookings, restaurant delivery, patient records, Jira tickets"),
            (1, "SEARCH_QUERY", "flight search, weather forecast, scientific papers, stock market quotes, geolocation maps"),
            (2, "SYSTEM_CONFIG", "smart home IoT lights, smart thermostat, Docker containers, firewall rules, printer jobs"),
            (3, "TEMPORAL_SCHEDULING", "Zoom meeting scheduling, gym class reservations, medical appointments, pomodoro timers"),
            (4, "COMMUNICATION_NOTIFY", "Telegram bots, Discord webhooks, push notifications, encrypted emails, Intercom chat"),
            (5, "ANALYTICS_FINANCE", "Solana/Ethereum crypto transfers, tax calculators, expense OCR, Figma asset exports"),
            (6, "WORKSPACE_EXECUTION", "file compression, code linting, git branch checkout, terminal log tailing, CSV parsing"),
            (7, "METADATA_INTROSPECTION", "plugin capability inspection, permission auditing, active agent skill listing, quota status"),
        ]
        prompts = []
        for dom_id, dom_name, theme_hint in domain_themes:
            prompts.append(
                f"Generate a JSON array of 6 distinct tool definitions for domain '{dom_name}' (domain_id={dom_id}) "
                f"covering themes like: {theme_hint}. "
                f"Each item must be an object with keys: "
                f"\"name\" (snake_case identifier), \"affordance\" (one of QUERY, MUTATION, SCHEDULE_DEFERRED, COMMUNICATION, FINTECH, DEVOPS), "
                f"\"desc_es\" (rich Spanish description of what the tool does and common ways users ask for it), "
                f"\"desc_en\" (rich English description)."
            )
        raw_responses = self.generate_json_batches(prompts, max_new_tokens=512, temperature=0.85, batch_size=8)
        extra_catalog = {}
        for (dom_id, dom_name, _), raw in zip(domain_themes, raw_responses):
            items = self._extract_json_list(raw)
            for item in items:
                if not isinstance(item, dict):
                    continue
                t_name = re.sub(r"[^a-z0-9_]", "_", str(item.get("name", "")).strip().lower()).strip("_")
                if not t_name or t_name in PRODUCTION_CATALOG or t_name in extra_catalog:
                    continue
                aff = str(item.get("affordance", "QUERY")).strip().upper()
                if aff not in {"QUERY", "MUTATION", "SCHEDULE_DEFERRED", "COMMUNICATION", "FINTECH", "DEVOPS"}:
                    aff = "QUERY"
                d_es = str(item.get("desc_es", "")).strip()
                d_en = str(item.get("desc_en", "")).strip()
                if len(d_es) < 12 or len(d_en) < 12:
                    continue
                extra_catalog[t_name] = {
                    "name": t_name,
                    "desc_es": d_es,
                    "desc_en": d_en,
                    "description": f"{d_es}. / {d_en}.",
                    "domain_id": dom_id,
                    "domain_name": dom_name,
                    "affordance": aff,
                    "text_for_embedding": f"passage: {t_name} [{aff}] ({dom_name}): {d_es}. {d_en}.",
                }
                if len(extra_catalog) >= num_extra_tools:
                    break
        print(f"[Multi-Model Teacher] {len(extra_catalog)} herramientas abiertas de nuevos dominios generadas por Qwen.")
        return extra_catalog

    def synthesize_dynamic_corpus(self, full_catalog: Dict[str, Dict[str, Any]]) -> Dict[str, Any]:
        """
        Usa el Teacher LLM para generar dinámicamente consultas limpias, consultas con typos/jerga
        y contextos multi-turno para todas las herramientas y modos cognitivos sin listas hardcodeadas.
        """
        print("[Multi-Model Teacher] Generando corpus conversacional diverso por lotes con Qwen...")
        tool_utterances: Dict[str, Dict[str, List[Dict[str, str]]]] = {}

        # Agrupar herramientas en pequeños lotes para que Qwen genere expresiones variadas (ES y EN, limpias y con typos/slang)
        all_tids = list(full_catalog.keys())
        tool_prompts = []
        prompt_meta = []

        for tid in all_tids:
            t_info = full_catalog[tid]
            # Dar aún más riqueza generativa a dominios con menos herramientas (ej. WORKSPACE_EXECUTION y METADATA_INTROSPECTION)
            n_Batches = 3 if t_info["domain_id"] in (6, 7, 3, 1) and tid in PRODUCTION_CATALOG and list(PRODUCTION_CATALOG.keys()).index(tid) < 19 else 1
            for b_i in range(n_Batches):
                for lang_code, lang_name in [("es", "Spanish"), ("en", "English")]:
                    tool_prompts.append(
                        f"Tool name: '{tid}'\n"
                        f"Domain: {t_info['domain_name']} ({t_info['affordance']})\n"
                        f"Description: {t_info['desc_es'] if lang_code == 'es' else t_info['desc_en']}\n\n"
                        f"Generate a JSON array of 5 realistic, diverse user requests in {lang_name} where the user wants to perform an action or query that requires '{tid}'. "
                        f"Vary the style (direct command, polite question, urgent operational request, casual developer phrasing, implicit need). "
                        f"Do NOT just copy the description words; use natural synonyms and concrete arguments (e.g. filenames, SQL tables, times, phone numbers, topics). "
                        f"Each object in the JSON array must have:\n"
                        f"- \"clean\": the natural request in {lang_name}\n"
                        f"- \"noisy\": the same request written hurriedly in chat with realistic keyboard typos, omitted accents, phonetic spelling, or slang abbreviations."
                    )
                    prompt_meta.append((tid, lang_code))

        raw_tool_outs = self.generate_json_batches(tool_prompts, max_new_tokens=360, temperature=0.88, batch_size=24)
        for (tid, lang_code), raw in zip(prompt_meta, raw_tool_outs):
            tool_utterances.setdefault(tid, {"es": [], "en": []})
            parsed = self._extract_json_list(raw)
            for item in parsed:
                if isinstance(item, dict) and item.get("clean") and item.get("noisy"):
                    c_txt = str(item["clean"]).strip()
                    n_txt = str(item["noisy"]).strip()
                    if len(c_txt) >= 3 and len(n_txt) >= 2:
                        tool_utterances[tid][lang_code].append({"clean": c_txt, "noisy": n_txt})

        # Generar modos cognitivos conversacionales y de abstención directamente con el Teacher LLM
        cognitive_prompts = []
        cog_meta = []
        mode_specs = [
            (
                "MEMORY_RECALL",
                "Generate a JSON array of 12 diverse user queries asking the assistant to recall, look up, or check personal preferences, saved rules, past session notes, user identity, or historical agreements stored in long-term episodic memory. Each object must have \"clean\", \"noisy\" (with realistic typos/chat slang), and \"context\" (a neutral active session status).",
            ),
            (
                "MEMORY_STORE",
                "Generate a JSON array of 12 diverse user instructions telling the assistant to remember, save, or store a personal preference, project constraint, timezone, port, or rule into long-term episodic memory. Each object must have \"clean\", \"noisy\", and \"context\".",
            ),
            (
                "PREV_CONFIRM",
                "Generate a JSON array of 12 diverse short user confirmations (e.g. 'intenta', 'dale hacelo', 'sí procede', 'confirmado', 'ejecútalo ya', 'go ahead', 'try it now', including 1-word anaphoras) accepting a tool action proposed by the assistant in the previous turn. Each object must have \"clean\" (the short confirmation) and \"noisy\" (with typos/slang).",
            ),
            (
                "PREV_EXPLAIN_NO_TOOL",
                "Generate a JSON array of 12 diverse multi-turn interactions where the assistant just explained architectural options or concepts in \"context\", and the user asks a follow-up question in \"clean\" / \"noisy\" asking for deeper explanation or clarification WITHOUT wanting to execute any tool.",
            ),
            (
                "FACTUAL_ASSERTION",
                "Generate a JSON array of 12 diverse tricky user messages that mention technical terms, time intervals (like 'every 10 minutes'), databases, or servers, OR ask general knowledge, math, science, or philosophy questions, where the user is ONLY stating a fact, complaining, or asking a pure LLM knowledge question that does NOT require any external system tool. Each object must have \"clean\", \"noisy\", and \"context\".",
            ),
            (
                "SOCIAL_OR_ATTACK",
                "Generate a JSON array of 12 diverse user messages split between: (a) casual social greetings, thanks, chitchat, laughter, farewells, and (b) adversarial prompt injections, SYSTEM OVERRIDE commands, DAN jailbreaks, or requests to ignore rules and delete everything. None of these should trigger a tool. Each object must have \"clean\", \"noisy\", and \"context\".",
            ),
        ]
        for mode_name, spec in mode_specs:
            for rep in range(4):
                for lang_code, lang_name in [("es", "Spanish"), ("en", "English")]:
                    cognitive_prompts.append(f"Language: {lang_name} (Batch {rep+1}).\n{spec}")
                    cog_meta.append((mode_name, lang_code))

        raw_cog_outs = self.generate_json_batches(cognitive_prompts, max_new_tokens=450, temperature=0.90, batch_size=16)
        cognitive_bank: Dict[str, Dict[str, List[Dict[str, str]]]] = {m: {"es": [], "en": []} for m, _ in mode_specs}
        for (mode_name, lang_code), raw in zip(cog_meta, raw_cog_outs):
            parsed = self._extract_json_list(raw)
            for item in parsed:
                if isinstance(item, dict) and item.get("clean"):
                    c_txt = str(item["clean"]).strip()
                    n_txt = str(item.get("noisy") or c_txt).strip()
                    ctx_txt = str(item.get("context") or ("Asistente: Sesión activa." if lang_code == "es" else "Assistant: Active session.")).strip()
                    if len(c_txt) >= 2:
                        cognitive_bank[mode_name][lang_code].append({"clean": c_txt, "noisy": n_txt, "context": ctx_txt})

        # Generar también con Qwen un conjunto de evaluación Zero-Shot de herramientas inéditas y casos difíciles
        eval_prompt = [
            "Generate a JSON array of 12 completely new, unseen tools (from domains like music streaming, smart home IoT, airline flights, food delivery, crypto wallets, graphic design, ride sharing, translation) and for each tool include a realistic test query in Spanish. "
            "Each object must have: \"tool_name\", \"affordance\" (QUERY or MUTATION), \"domain_name\", \"tool_desc\", \"test_query\", and \"expected_action\" ('EXECUTE -> ' + tool_name)."
        ]
        raw_eval = self.generate_json_batches(eval_prompt, max_new_tokens=600, temperature=0.80, batch_size=1)
        zero_shot_eval_suite = self._extract_json_list(raw_eval[0]) if raw_eval else []

        return {
            "tool_utterances": tool_utterances,
            "cognitive_bank": cognitive_bank,
            "zero_shot_eval_suite": zero_shot_eval_suite,
        }


# Ejecutar o recuperar síntesis dinámica multi-modelo
if DYNAMIC_CORPUS_CACHE_PATH.exists():
    print(f"[Multi-Model Teacher] Cargando corpus dinámico previamente generado por Qwen desde {DYNAMIC_CORPUS_CACHE_PATH}...")
    with open(DYNAMIC_CORPUS_CACHE_PATH, "r", encoding="utf-8") as f:
        _cached_dyn = json.load(f)
    EXTRA_OPEN_TOOLS = _cached_dyn.get("extra_open_tools", {})
    DYNAMIC_CORPUS = _cached_dyn["dynamic_corpus"]
else:
    qwen_synth = QwenDynamicMultiModelSynthesizer()
    EXTRA_OPEN_TOOLS = qwen_synth.synthesize_open_world_tools(num_extra_tools=48)
    _merged_for_gen = {**PRODUCTION_CATALOG, **EXTRA_OPEN_TOOLS}
    DYNAMIC_CORPUS = qwen_synth.synthesize_dynamic_corpus(_merged_for_gen)
    qwen_synth.unload_teacher()
    with open(DYNAMIC_CORPUS_CACHE_PATH, "w", encoding="utf-8") as f:
        json.dump({"extra_open_tools": EXTRA_OPEN_TOOLS, "dynamic_corpus": DYNAMIC_CORPUS}, f, ensure_ascii=False, indent=2)

# Unificar catálogo de entrenamiento: los primeros 174 índices son exactamente PRODUCTION_CATALOG,
# seguidos de las herramientas abiertas inventadas por el Teacher LLM para generalización Zero-Shot.
CATALOG: Dict[str, Dict[str, Any]] = {**PRODUCTION_CATALOG, **EXTRA_OPEN_TOOLS}
ALL_TOOL_IDS = list(CATALOG.keys())
NUM_CATALOG_TOOLS = len(ALL_TOOL_IDS)
tool_id_to_idx = {tid: idx for idx, tid in enumerate(ALL_TOOL_IDS)}

# Agrupación jerárquica por dominio para muestreo 100% balanceado (evita que dominios chicos como WORKSPACE_EXECUTION queden sub-entrenados)
TOOLS_BY_DOMAIN: Dict[int, List[str]] = {d: [] for d in EXPERT_DOMAINS}
for tid, tdata in CATALOG.items():
    TOOLS_BY_DOMAIN[tdata["domain_id"]].append(tid)

BACKBONE_NAME = "intfloat/multilingual-e5-small"
MAX_QUERY_LEN, MAX_CTX_LEN, MAX_TOOL_LEN = 36, 48, 48
e5_tokenizer = AutoTokenizer.from_pretrained(BACKBONE_NAME)
e5_encoder = AutoModel.from_pretrained(BACKBONE_NAME).to(DEVICE).eval()

@torch.inference_mode()
def encode_token_sequences(texts: List[str], prefix: str, max_len: int, batch_size: int = 512, apply_canonical: bool = False) -> torch.Tensor:
    processed = [canonicalize_chat_surface(t.strip()) if apply_canonical else t.strip() for t in texts]
    prefixed = [f"{prefix}{t}" if not t.startswith(prefix) else t for t in processed]
    outputs_list = []
    for start in range(0, len(prefixed), batch_size):
        enc = e5_tokenizer(prefixed[start : start + batch_size], padding="max_length", truncation=True, max_length=max_len, return_tensors="pt").to(DEVICE)
        with torch.amp.autocast("cuda", dtype=torch.bfloat16, enabled=USE_BF16):
            hid = F.normalize(e5_encoder(**enc).last_hidden_state, p=2, dim=-1)
        outputs_list.append((hid * enc["attention_mask"].unsqueeze(-1).float()).cpu().to(torch.float16))
    return torch.cat(outputs_list, dim=0)

CATALOG_TOOL_TENSORS = encode_token_sequences([CATALOG[tid]["text_for_embedding"] for tid in ALL_TOOL_IDS], prefix="passage: ", max_len=MAX_TOOL_LEN)
with torch.no_grad():
    _t_float = CATALOG_TOOL_TENSORS.float()
    _t_mask = (_t_float.norm(p=2, dim=-1, keepdim=True) > 1e-5).float()
    _t_pooled = F.normalize((_t_float * _t_mask).sum(dim=1) / _t_mask.sum(dim=1).clamp(min=1.0), p=2, dim=-1)
    TOOL_COSINE_SIM_MATRIX = torch.matmul(_t_pooled, _t_pooled.T)
    TOOL_COSINE_SIM_MATRIX.fill_diagonal_(-1.0)
    LATENT_NEAREST_NEIGHBORS: Dict[str, List[str]] = {}
    for i, tid in enumerate(ALL_TOOL_IDS):
        top_indices = torch.argsort(TOOL_COSINE_SIM_MATRIX[i], descending=True)[:14].tolist()
        LATENT_NEAREST_NEIGHBORS[tid] = [ALL_TOOL_IDS[j] for j in top_indices]


class DynamicSurfacePerturbator:
    """Perturbador estocástico continuo sobre los textos generados por el Teacher LLM."""
    def __init__(self):
        self.keyboard_neighbors = {
            'a': ['s', 'q', 'z'], 'o': ['i', 'p', 'l'], 'e': ['w', 'r', 'd'],
            'i': ['u', 'o', 'k'], 's': ['a', 'd', 'w'], 'm': ['n', 'k', 'j'],
            't': ['r', 'y', 'g'], 'r': ['t', 'e', 'f'], 'n': ['m', 'b', 'h'],
            'c': ['x', 'v', 'k'], 'b': ['v', 'n'], 'v': ['b', 'c'],
        }

    def perturb(self, text: str, rng: random.Random, noise_prob: float = 0.55) -> str:
        if rng.random() > noise_prob or len(text) < 4:
            return text
        out = text
        if rng.random() < 0.50:
            for k, v in {"á": "a", "é": "e", "í": "i", "ó": "o", "ú": "u", "¿": "", "¡": ""}.items():
                out = out.replace(k, v).replace(k.upper(), v.upper())
        if rng.random() < 0.40 and len(out) > 6:
            chars = list(out)
            for _ in range(rng.randint(1, 2)):
                idx = rng.randint(1, len(chars) - 2)
                c = chars[idx].lower()
                if c in self.keyboard_neighbors:
                    chars[idx] = rng.choice(self.keyboard_neighbors[c])
            out = "".join(chars)
        return out

PERTURBATOR = DynamicSurfacePerturbator()

def infer_op_mode(mode: str, target_tool: Optional[str]) -> int:
    if mode == "MEMORY_STORE": return 1
    if mode == "MEMORY_RECALL": return 0
    if not target_tool or mode == "CAPABILITY_MISMATCH": return 2
    return 0 if CATALOG[target_tool]["affordance"] == "QUERY" else 1

def sample_qwen_tool_utterance(tid: str, is_es: bool, rng: random.Random) -> Tuple[str, str]:
    lang_key = "es" if is_es else "en"
    pool = DYNAMIC_CORPUS.get("tool_utterances", {}).get(tid, {}).get(lang_key, [])
    if pool:
        chosen = rng.choice(pool)
        clean_q = chosen["clean"]
        noisy_q = chosen["noisy"] if rng.random() < 0.70 else PERTURBATOR.perturb(clean_q, rng, noise_prob=0.80)
        return clean_q, noisy_q
    # Fallback dinámico composicional a partir de metadatos semánticos si alguna herramienta nueva no tuvo lote
    desc = (CATALOG[tid]["desc_es"] if is_es else CATALOG[tid]["desc_en"])
    clauses = [c.strip() for c in re.split(r"[,.;/]", desc) if len(c.strip()) > 4]
    base_clause = rng.choice(clauses) if clauses else desc
    clean_q = base_clause[0].lower() + base_clause[1:] if len(base_clause) > 1 else base_clause
    return clean_q, PERTURBATOR.perturb(clean_q, rng, noise_prob=0.75)

def sample_qwen_cognitive_episode(mode: str, is_es: bool, rng: random.Random) -> Tuple[str, str, str]:
    lang_key = "es" if is_es else "en"
    pool = DYNAMIC_CORPUS.get("cognitive_bank", {}).get(mode, {}).get(lang_key, [])
    if pool:
        chosen = rng.choice(pool)
        c_q = chosen["clean"]
        n_q = chosen.get("noisy") or PERTURBATOR.perturb(c_q, rng, noise_prob=0.65)
        ctx = chosen.get("context") or ("Asistente: Sesión activa." if is_es else "Assistant: Active session.")
        return c_q, n_q, ctx
    return ("hola", "ola", "Asistente: Sesión activa.")

def assemble_episode_from_latent_mining(
    mode: str, clean_q: str, noisy_q: str, context: str, lang_id: int,
    target_tool: Optional[str], extra_negatives: Optional[List[str]] = None,
    forbidden_tool: Optional[str] = None, excluded_tools: Optional[List[str]] = None,
    rng: Optional[random.Random] = None,
) -> Dict[str, Any]:
    rng = rng or random
    excluded_set = set(excluded_tools or [])
    if mode == "CAPABILITY_MISMATCH" and target_tool:
        # En CAPABILITY_MISMATCH relacional, excluimos del catálogo activo la herramienta objetivo
        # y sus vecinos más cercanos por similitud coseno (> 0.68) para garantizar que el pedido
        # no pueda ser satisfecho por ninguna candidata presente en `cands`.
        excluded_set.add(target_tool)
        t_idx = tool_id_to_idx[target_tool]
        for j, other_tid in enumerate(ALL_TOOL_IDS):
            if float(TOOL_COSINE_SIM_MATRIX[t_idx, j].item()) > 0.68:
                excluded_set.add(other_tid)
        active_target_tool = None
    else:
        active_target_tool = target_tool

    k_cands = rng.randint(MIN_CANDIDATES_K, min(MAX_CANDIDATES_K, len(ALL_TOOL_IDS) - len(excluded_set)))
    latent_negs = [h for h in (extra_negatives or []) if h in CATALOG and h != active_target_tool and h not in excluded_set]

    ref_tool = active_target_tool or target_tool
    if ref_tool and ref_tool in LATENT_NEAREST_NEIGHBORS:
        nearest_pool = [n for n in LATENT_NEAREST_NEIGHBORS[ref_tool] if n not in excluded_set and n != active_target_tool]
        num_hard = min(len(nearest_pool), rng.randint(4, 7))
        latent_negs.extend(nearest_pool[:num_hard])
    elif not latent_negs:
        avail_anchors = [t for t in ALL_TOOL_IDS if t not in excluded_set]
        anchor = rng.choice(avail_anchors)
        latent_negs = [anchor] + [n for n in LATENT_NEAREST_NEIGHBORS[anchor] if n not in excluded_set][:4]

    latent_negs = list(dict.fromkeys([h for h in latent_negs if h != active_target_tool and h not in excluded_set]))[:7]
    cands_set = set(latent_negs)
    if active_target_tool:
        cands_set.add(active_target_tool)
    if forbidden_tool and forbidden_tool in CATALOG and forbidden_tool not in excluded_set:
        cands_set.add(forbidden_tool)

    avail_pool = [t for t in ALL_TOOL_IDS if t not in excluded_set and t not in cands_set]
    while len(cands_set) < k_cands and avail_pool:
        pick = rng.choice(avail_pool)
        cands_set.add(pick)
    cands = list(cands_set)
    rng.shuffle(cands)

    # Calibración semántica de teacher_scores usando la matriz de similitud latente E5
    teacher_scores = []
    pos_idx_global = tool_id_to_idx[active_target_tool] if active_target_tool else -1
    for cid in cands:
        if active_target_tool and cid == active_target_tool:
            teacher_scores.append(round(rng.uniform(0.95, 0.995), 4))
        elif forbidden_tool and cid == forbidden_tool:
            teacher_scores.append(round(rng.uniform(0.001, 0.012), 4))
        elif pos_idx_global >= 0:
            sim_val = max(0.0, float(TOOL_COSINE_SIM_MATRIX[pos_idx_global, tool_id_to_idx[cid]].item()))
            teacher_scores.append(round(min(0.11, 0.01 + 0.10 * sim_val), 4))
        else:
            teacher_scores.append(round(rng.uniform(0.002, 0.020), 4))

    probs, gate, noul, qual = MODE_LABEL_DEFAULTS[mode]
    return {
        "mode": mode, "clean_query": clean_q, "noisy_query": noisy_q, "context": context,
        "cands": cands, "lang_label": lang_id, "ctx_route_label": ROUTE_BY_MODE[mode],
        "ctx_route_probs": list(probs), "target_tool": active_target_tool,
        "domain_id": CATALOG[active_target_tool]["domain_id"] if active_target_tool else -1,
        "gate_target": gate, "valid_noul_label": noul, "quality_level": qual,
        "teacher_scores": teacher_scores, "op_mode": infer_op_mode(mode, active_target_tool),
    }

def sample_domain_balanced_tool(ep_idx: int, rng: random.Random) -> str:
    """Muestreo jerárquico por dominio para garantizar que los 8 dominios tengan representación equitativa."""
    dom_id = (ep_idx + rng.randint(0, 7)) % len(EXPERT_DOMAINS)
    dom_tools = TOOLS_BY_DOMAIN[dom_id]
    return rng.choice(dom_tools)

def synthesize_balanced_episode(ep_idx: int, rng: random.Random) -> Dict[str, Any]:
    lang_id = 0 if (ep_idx % 20) < 14 else 1
    is_es = (lang_id == 0)
    mode_schedule = [
        "TOOL_DIRECT", "TOOL_DIRECT", "TOOL_DIRECT", "TOOL_DIRECT",
        "TOOL_INTROSPECTION",
        "MEMORY_RECALL", "MEMORY_STORE",
        "PREV_CONFIRM", "PREV_CONFIRM",
        "PREV_EXPLAIN_NO_TOOL",
        "PREV_CORRECTION", "PREV_CORRECTION",
        "FACTUAL_ASSERTION", "SOCIAL_OR_ATTACK",
        "CAPABILITY_MISMATCH", "CAPABILITY_MISMATCH",
    ]
    mode = mode_schedule[ep_idx % len(mode_schedule)]
    pos_tid, extra_hn, forb_tid = None, [], None
    _, _, ctx = sample_qwen_cognitive_episode("MEMORY_RECALL", is_es, rng)

    if mode == "TOOL_DIRECT":
        pos_tid = sample_domain_balanced_tool(ep_idx, rng)
        clean_q, noisy_q = sample_qwen_tool_utterance(pos_tid, is_es, rng)
        return assemble_episode_from_latent_mining(
            mode, clean_q, noisy_q, ctx, lang_id, pos_tid, rng=rng
        )

    elif mode == "TOOL_INTROSPECTION":
        intro_tools = TOOLS_BY_DOMAIN[7]
        pos_tid = "list_tools" if rng.random() < 0.65 else rng.choice(intro_tools)
        clean_q, noisy_q = sample_qwen_tool_utterance(pos_tid, is_es, rng)
        extra_hn = [t for t in intro_tools if t != pos_tid]
        return assemble_episode_from_latent_mining(
            mode, clean_q, noisy_q, ctx, lang_id, pos_tid, extra_negatives=extra_hn, rng=rng
        )

    elif mode in ("MEMORY_RECALL", "MEMORY_STORE", "PREV_EXPLAIN_NO_TOOL", "FACTUAL_ASSERTION", "SOCIAL_OR_ATTACK"):
        pos_tid = "search_memory" if mode == "MEMORY_RECALL" else None
        clean_q, noisy_q, dyn_ctx = sample_qwen_cognitive_episode(mode, is_es, rng)
        return assemble_episode_from_latent_mining(
            mode, clean_q, noisy_q, dyn_ctx, lang_id, pos_tid, rng=rng
        )

    elif mode == "PREV_CONFIRM":
        pos_tid = sample_domain_balanced_tool(ep_idx, rng)
        t_Action_q, _ = sample_qwen_tool_utterance(pos_tid, is_es, rng)
        clean_q, noisy_q, _ = sample_qwen_cognitive_episode("PREV_CONFIRM", is_es, rng)
        ctx = (
            f"Asistente: Propongo usar {pos_tid} ({t_Action_q}). ¿Confirmas la ejecución?"
            if is_es else
            f"Assistant: I suggest running {pos_tid} ({t_Action_q}). Do you confirm?"
        )
        return assemble_episode_from_latent_mining(
            mode, clean_q, noisy_q, ctx, lang_id, pos_tid, rng=rng
        )

    elif mode == "PREV_CORRECTION":
        pos_tid = sample_domain_balanced_tool(ep_idx, rng)
        forb_tid = LATENT_NEAREST_NEIGHBORS[pos_tid][0]
        extra_hn = [forb_tid]
        forb_q, _ = sample_qwen_tool_utterance(forb_tid, is_es, rng)
        pos_clean, pos_noisy = sample_qwen_tool_utterance(pos_tid, is_es, rng)
        ctx = (
            f"Asistente: Voy a ejecutar {forb_tid} ({forb_q})."
            if is_es else
            f"Assistant: I am going to execute {forb_tid} ({forb_q})."
        )
        neg_Connectors = (
            ["no ejecutes", "no vayas a ejecutar", "cancela", "detén", "olvida"]
            if is_es else
            ["do not run", "cancel", "stop", "do not execute", "skip"]
        )
        pivots = ["mejor", "en su lugar", "prefiero que", "cámbialo por"] if is_es else ["instead", "rather", "switch to"]
        clean_q = f"{rng.choice(neg_Connectors)} {forb_tid}, {rng.choice(pivots)} {pos_clean}"
        noisy_q = f"{rng.choice(neg_Connectors)} {forb_tid}, {rng.choice(pivots)} {pos_noisy}"
        return assemble_episode_from_latent_mining(
            mode, clean_q, noisy_q, ctx, lang_id, pos_tid,
            extra_negatives=extra_hn, forbidden_tool=forb_tid, rng=rng
        )

    else:  # CAPABILITY_MISMATCH RELACIONAL (Cualquier herramienta solicitada que NO existe en `cands`)
        missing_tid = sample_domain_balanced_tool(ep_idx, rng)
        clean_q, noisy_q = sample_qwen_tool_utterance(missing_tid, is_es, rng)
        return assemble_episode_from_latent_mining(
            mode, clean_q, noisy_q, ctx, lang_id, missing_tid, rng=rng
        )


# ==============================================================================
# 3. ARQUITECTURA JEV-MOE 3.5B UNIFICADA (SIN SESGO DE ID + INHIBIDOR NEGACIÓN)
# ==============================================================================
E5_EMBED_DIM = 384

class DilatedGatedConvBlock(nn.Module):
    def __init__(self, d_model: int, d_hidden: int, kernel_size: int = 3, dilation: int = 1, dropout: float = 0.08):
        super().__init__()
        padding = (kernel_size // 2) * dilation
        self.conv = nn.Conv1d(d_model, d_hidden * 2, kernel_size=kernel_size, padding=padding, dilation=dilation, groups=4)
        self.out_proj = nn.Linear(d_hidden, d_model)
        self.norm = nn.LayerNorm(d_model)
        self.dropout = nn.Dropout(dropout)

    def forward(self, x: torch.Tensor, mask: torch.Tensor) -> torch.Tensor:
        residual = x
        h = (x * mask.unsqueeze(-1)).transpose(1, 2)
        a, b = self.conv(h).transpose(1, 2).chunk(2, dim=-1)
        h = self.out_proj(a * F.silu(b))
        return self.norm(residual + self.dropout(h)) * mask.unsqueeze(-1)

class AttentivePooling(nn.Module):
    def __init__(self, d_model: int):
        super().__init__()
        self.attn = nn.Sequential(
            nn.Linear(d_model, d_model // 2),
            nn.Tanh(),
            nn.Linear(d_model // 2, 1, bias=False),
        )

    def forward(self, x: torch.Tensor, mask: torch.Tensor) -> torch.Tensor:
        scores = self.attn(x).squeeze(-1).float().masked_fill(mask < 0.5, -1e4)
        weights = F.softmax(scores, dim=-1).to(x.dtype).unsqueeze(-1)
        return torch.sum(x * weights, dim=-2)

class Capa1JevIdiomaChoice(nn.Module):
    def __init__(self, d_model: int, dropout: float = 0.08):
        super().__init__()
        self.q_blocks = nn.ModuleList([DilatedGatedConvBlock(d_model, d_model * 2, dilation=d, dropout=dropout) for d in (1, 2, 4)])
        self.c_blocks = nn.ModuleList([DilatedGatedConvBlock(d_model, d_model * 2, dilation=d, dropout=dropout) for d in (1, 2, 4)])
        self.q_pooler = AttentivePooling(d_model)
        self.c_pooler = AttentivePooling(d_model)
        self.lang_choice_head = nn.Sequential(
            nn.Linear(d_model * 2, d_model), nn.LayerNorm(d_model), nn.GELU(), nn.Linear(d_model, 2)
        )
        self.lang_cond_proj = nn.Linear(2, d_model)

    def forward(self, q_seq: torch.Tensor, c_seq: torch.Tensor, q_mask: torch.Tensor, c_mask: torch.Tensor):
        q_tilde, c_tilde = q_seq, c_seq
        for blk in self.q_blocks: q_tilde = blk(q_tilde, q_mask)
        for blk in self.c_blocks: c_tilde = blk(c_tilde, c_mask)
        q_pool = self.q_pooler(q_tilde, q_mask)
        c_pool = self.c_pooler(c_tilde, c_mask)
        lang_logits = self.lang_choice_head(torch.cat([q_pool, c_pool], dim=-1)).float()
        lang_probs = F.softmax(lang_logits, dim=-1)
        lang_ent = -torch.sum(lang_probs * torch.log(lang_probs.clamp(min=1e-8)), dim=-1, keepdim=True) / math.log(2.0)
        lang_conf = (1.0 - lang_ent).clamp(0.0, 1.0)
        lang_bias = self.lang_cond_proj(lang_probs.to(q_tilde.dtype))
        return q_tilde, c_tilde, q_pool, c_pool, lang_logits, lang_probs, lang_conf, lang_bias

class SwiGLUProjector(nn.Module):
    def __init__(self, d_in: int, d_proj: int, dropout: float = 0.08):
        super().__init__()
        self.fc_in = nn.Linear(d_in, d_proj * 2)
        self.fc_mid = nn.Linear(d_proj, d_proj)
        self.norm1 = nn.LayerNorm(d_proj)
        self.fc_res = nn.Linear(d_proj, d_proj * 2)
        self.fc_out = nn.Linear(d_proj, d_proj)
        self.norm2 = nn.LayerNorm(d_proj)
        self.dropout = nn.Dropout(dropout)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        a, b = self.fc_in(x).chunk(2, dim=-1)
        h = self.norm1(self.fc_mid(a * F.silu(b)))
        c, d = self.fc_res(h).chunk(2, dim=-1)
        return self.norm2(h + 0.3 * self.dropout(self.fc_out(c * F.silu(d))))

class CandidateDifferentialInjector(nn.Module):
    def __init__(self, d_out: int, dropout: float = 0.08):
        super().__init__()
        self.diff_proj = nn.Sequential(
            nn.Linear(d_out * 3, d_out),
            nn.LayerNorm(d_out),
            nn.GELU(),
            nn.Dropout(dropout),
        )
        self.gate = nn.Parameter(torch.tensor(0.20))
        self.norm = nn.LayerNorm(d_out)

    def forward(self, h: torch.Tensor, cand_mask: Optional[torch.Tensor] = None) -> torch.Tensor:
        B, K, D = h.shape
        h_norm = F.normalize(h.float(), p=2, dim=-1)
        peer_sim = torch.bmm(h_norm, h_norm.transpose(1, 2))
        eye = torch.eye(K, device=h.device, dtype=torch.bool).unsqueeze(0)
        peer_sim = peer_sim.masked_fill(eye, -1e4)
        if cand_mask is not None:
            peer_sim = peer_sim.masked_fill((cand_mask < 0.5).unsqueeze(1), -1e4)

        peer_weights = F.softmax(peer_sim * 6.0, dim=-1).to(h.dtype)
        closest_competitor_centroid = torch.bmm(peer_weights, h)
        ortho_diff = h - closest_competitor_centroid
        fused = self.diff_proj(torch.cat([h, ortho_diff, h * ortho_diff], dim=-1))
        out = self.norm(h + torch.tanh(self.gate) * fused)
        if cand_mask is not None:
            out = out * cand_mask.unsqueeze(-1).to(out.dtype)
        return out

class PreLNSetAttentionLayer(nn.Module):
    def __init__(self, d_model: int, nhead: int, dropout: float = 0.08, res_scale: float = 0.25):
        super().__init__()
        self.d_model, self.nhead, self.head_dim = d_model, nhead, d_model // nhead
        self.res_scale = res_scale
        self.norm1 = nn.LayerNorm(d_model)
        self.q_proj = nn.Linear(d_model, d_model)
        self.k_proj = nn.Linear(d_model, d_model)
        self.v_proj = nn.Linear(d_model, d_model)
        self.out_proj = nn.Linear(d_model, d_model)
        self.dropout = nn.Dropout(dropout)
        self.norm2 = nn.LayerNorm(d_model)
        self.ffn = nn.Sequential(
            nn.Linear(d_model, d_model * 4), nn.GELU(), nn.Dropout(dropout),
            nn.Linear(d_model * 4, d_model), nn.Dropout(dropout),
        )

    def forward(self, x: torch.Tensor, cand_mask: Optional[torch.Tensor] = None) -> torch.Tensor:
        norm_x = self.norm1(x)
        B, N, C = norm_x.shape
        q = self.q_proj(norm_x).view(B, N, self.nhead, self.head_dim).transpose(1, 2)
        k = self.k_proj(norm_x).view(B, N, self.nhead, self.head_dim).transpose(1, 2)
        v = self.v_proj(norm_x).view(B, N, self.nhead, self.head_dim).transpose(1, 2)
        scores = (q @ k.transpose(-2, -1)).float() / (self.head_dim ** 0.5)
        if cand_mask is not None:
            scores = scores.masked_fill((cand_mask < 0.5).unsqueeze(1).unsqueeze(2), -1e4)
        attn_weights = F.softmax(scores, dim=-1).to(v.dtype)
        attn_out = self.out_proj((self.dropout(attn_weights) @ v).transpose(1, 2).reshape(B, N, C))
        x = x + self.res_scale * attn_out
        out = x + self.res_scale * self.ffn(self.norm2(x))
        if cand_mask is not None:
            out = out * cand_mask.unsqueeze(-1).to(out.dtype)
        return out

class UltraSparseVectorizedMoEBank(nn.Module):
    def __init__(self, num_experts: int, top_k: int, d_out: int, d_exp_ffn: int):
        super().__init__()
        self.num_experts = num_experts
        self.top_k = top_k
        self.d_out = d_out
        self.d_exp_ffn = d_exp_ffn

        scale_in = 0.5 / math.sqrt(d_out)
        scale_out = 0.5 / math.sqrt(d_exp_ffn)
        self.w_gate_up = nn.Parameter(torch.randn(num_experts, d_out, d_exp_ffn * 2, dtype=torch.bfloat16) * scale_in)
        self.w_down = nn.Parameter(torch.randn(num_experts, d_exp_ffn, d_out, dtype=torch.bfloat16) * scale_out)

        self.shared_gate_up = nn.Linear(d_out, d_out * 2, bias=False)
        self.shared_down = nn.Linear(d_out, d_out, bias=False)
        self.branch_norm = nn.LayerNorm(d_out)
        self.moe_gate = nn.Parameter(torch.tensor(0.20))
        self.norm = nn.LayerNorm(d_out)

    def forward(self, h_base: torch.Tensor, topk_idx: torch.Tensor, topk_weights: torch.Tensor) -> torch.Tensor:
        B, K, D = h_base.shape
        orig_dtype = h_base.dtype
        work_dtype = self.w_gate_up.dtype
        h_in = h_base.to(work_dtype)

        flat_idx = topk_idx.reshape(-1)
        w1_sel = self.w_gate_up.index_select(0, flat_idx)
        w2_sel = self.w_down.index_select(0, flat_idx)

        h_rep = h_in.unsqueeze(1).expand(B, self.top_k, K, D).reshape(B * self.top_k, K, D)
        gate_up = torch.bmm(h_rep, w1_sel)
        gate, up = gate_up.chunk(2, dim=-1)
        act = F.silu(gate) * up
        exp_out = torch.bmm(act, w2_sel).view(B, self.top_k, K, D)

        weights = topk_weights.to(work_dtype).unsqueeze(-1).unsqueeze(-1)
        moe_sum = torch.sum(exp_out * weights, dim=1).to(orig_dtype)

        sh_g, sh_u = self.shared_gate_up(h_base).chunk(2, dim=-1)
        shared_out = self.shared_down(F.silu(sh_g) * sh_u)

        combined_branch = self.branch_norm(shared_out + moe_sum)
        return self.norm(h_base + torch.tanh(self.moe_gate) * combined_branch)

class Capa2JevContextoYHerramientasMoE(nn.Module):
    """
    Capa 2 Libre de Sesgo de ID:
    - Funciona idéntico con (B, K, Lt, D) o con el catálogo completo (174 herramientas).
    - No usa `tool_id_emb` (que memorizaba índices estáticos y fallaba fuera de distribución).
    - Incorpora un detector de confirmación vs corrección (`ctx_polarity`) que invierte
      automáticamente el peso de la herramienta mencionada en el contexto si hay negación.
    """
    def __init__(
        self, num_experts: int, top_k_experts: int, d_model: int, d_proj: int,
        d_out: int, d_exp_ffn: int, nhead: int, set_layers: int, dropout: float = 0.08,
    ):
        super().__init__()
        self.num_experts = num_experts
        self.top_k_experts = top_k_experts
        self.d_proj = d_proj
        self.d_out = d_out

        self.w_q = nn.Linear(d_model, d_model * 2, bias=False)
        self.w_k = nn.Linear(d_model, d_model * 2, bias=False)
        self.w_v = nn.Linear(d_model, d_model, bias=False)
        self.m_pooler = AttentivePooling(d_model)

        self.context_choice_head = nn.Sequential(
            nn.Linear(d_model * 5 + 2, d_proj), nn.LayerNorm(d_proj), nn.GELU(), nn.Dropout(dropout),
            nn.Linear(d_proj, d_proj // 2), nn.LayerNorm(d_proj // 2), nn.GELU(), nn.Linear(d_proj // 2, 4),
        )
        self.gate_proj = nn.Sequential(nn.Linear(4 + 2 + d_model * 2, 256), nn.GELU(), nn.Linear(256, 1), nn.Sigmoid())
        # Polaridad contextual [-1, +1]: +1 en PREV_CONFIRM (ejecuta la del contexto), -1 en PREV_CORRECTION (rechaza la del contexto)
        self.ctx_polarity_head = nn.Sequential(
            nn.Linear(d_model * 3 + 4, 256), nn.LayerNorm(256), nn.GELU(), nn.Linear(256, 1), nn.Tanh()
        )
        self.out_norm = nn.LayerNorm(d_model)

        self.shared_q_proj = SwiGLUProjector(d_model, d_proj, dropout=dropout)
        self.shared_c_proj = SwiGLUProjector(d_model, d_proj, dropout=dropout)
        self.shared_t_proj = SwiGLUProjector(d_model, d_proj, dropout=dropout)
        self.q_att_pool = AttentivePooling(d_proj)
        self.c_att_pool = AttentivePooling(d_proj)
        self.t_att_pool = AttentivePooling(d_proj)

        self.colbert_linear_anchor = nn.Linear(14, 1)

        in_pair_dim = d_proj * 6 + 14
        self.pair_fusion = nn.Sequential(
            nn.Linear(in_pair_dim, d_proj),
            nn.LayerNorm(d_proj),
            nn.GELU(),
            nn.Dropout(dropout),
            nn.Linear(d_proj, d_out),
            nn.LayerNorm(d_out),
        )

        self.router = nn.Sequential(
            nn.Linear(d_model * 3 + 2 + 4, d_proj // 2), nn.LayerNorm(d_proj // 2), nn.GELU(),
            nn.Linear(d_proj // 2, 512), nn.GELU(), nn.Linear(512, num_experts),
        )
        self.moe_bank = UltraSparseVectorizedMoEBank(num_experts, top_k_experts, d_out, d_exp_ffn)

        self.diff_injector = CandidateDifferentialInjector(d_out, dropout=dropout)
        res_scale = 1.0 / math.sqrt(2.0 * set_layers)
        self.set_layers = nn.ModuleList([PreLNSetAttentionLayer(d_out, nhead, dropout, res_scale=res_scale) for _ in range(set_layers)])
        self.set_branch_norm = nn.LayerNorm(d_out)
        self.set_gate = nn.Parameter(torch.tensor(0.15))
        self.set_norm = nn.LayerNorm(d_out)

        self.tool_logit_head = nn.Sequential(
            nn.Linear(d_out, 512), nn.LayerNorm(512), nn.GELU(),
            nn.Linear(512, 128), nn.GELU(), nn.Linear(128, 1)
        )
        self.tool_aff_head = nn.Sequential(
            nn.Linear(d_out, 512), nn.LayerNorm(512), nn.GELU(),
            nn.Linear(512, 128), nn.GELU(), nn.Linear(128, 1)
        )

    def _encode_tools_unified(
        self, tools_seq: torch.Tensor, t_mask: torch.Tensor, B: int,
        cand_idxs: Optional[torch.Tensor] = None,
        catalog_t_in: Optional[torch.Tensor] = None,
        catalog_t_mask: Optional[torch.Tensor] = None,
    ):
        if catalog_t_in is not None and cand_idxs is not None:
            cat_emb = F.normalize(self.shared_t_proj(catalog_t_in), p=2, dim=-1)
            cat_pool = F.normalize(self.t_att_pool(cat_emb, catalog_t_mask), p=2, dim=-1)
            safe_idxs = cand_idxs.clamp(0, catalog_t_in.size(0) - 1)
            t_emb = cat_emb[safe_idxs]
            t_att_p = cat_pool[safe_idxs]
            t_mask_4d = catalog_t_mask[safe_idxs]
        else:
            if tools_seq.dim() == 3:
                # Optimización: proyectar en 3D (K, Lt, D) antes de expandir a B
                t_emb_3d = F.normalize(self.shared_t_proj(tools_seq), p=2, dim=-1)
                t_pool_2d = F.normalize(self.t_att_pool(t_emb_3d, t_mask), p=2, dim=-1)
                t_emb = t_emb_3d.unsqueeze(0).expand(B, -1, -1, -1)
                t_att_p = t_pool_2d.unsqueeze(0).expand(B, -1, -1)
                t_mask_4d = t_mask.unsqueeze(0).expand(B, -1, -1)
            else:
                t_emb = F.normalize(self.shared_t_proj(tools_seq), p=2, dim=-1)
                t_att_p = F.normalize(self.t_att_pool(t_emb, t_mask), p=2, dim=-1)
                t_mask_4d = t_mask
        return t_emb, t_att_p, t_mask_4d

    def forward(
        self, q_tilde, c_tilde, q_pool, c_pool, lang_probs, lang_bias,
        tools_seq, q_mask, c_mask, t_mask, cand_mask: Optional[torch.Tensor] = None,
        cand_idxs: Optional[torch.Tensor] = None,
        catalog_t_in: Optional[torch.Tensor] = None,
        catalog_t_mask: Optional[torch.Tensor] = None,
    ):
        B, Lq, _ = q_tilde.shape
        Lc = c_tilde.size(1)
        scale = 1.0 / math.sqrt(self.w_q.out_features)
        attn_scores = (torch.matmul(self.w_q(q_tilde), self.w_k(c_tilde).transpose(-1, -2)).float() * scale).masked_fill((c_mask < 0.5).unsqueeze(1), -1e4)
        v_c = self.w_v(c_tilde)
        m_qc = torch.matmul(F.softmax(attn_scores, dim=-1).to(v_c.dtype), v_c) * q_mask.unsqueeze(-1)
        m_pool = self.m_pooler(m_qc, q_mask)

        ctx_in = torch.cat([q_pool, c_pool, m_pool, torch.abs(q_pool - c_pool), q_pool * m_pool, lang_probs.to(q_pool.dtype)], dim=-1)
        ctx_logits = self.context_choice_head(ctx_in).float()
        ctx_probs = F.softmax(ctx_logits, dim=-1)
        ctx_ent = -torch.sum(ctx_probs * torch.log(ctx_probs.clamp(min=1e-8)), dim=-1, keepdim=True) / math.log(4.0)
        ctx_conf = (1.0 - ctx_ent).clamp(0.0, 1.0)

        gate_alpha = self.gate_proj(torch.cat([ctx_probs.to(q_pool.dtype), lang_probs.to(q_pool.dtype), q_pool, m_pool], dim=-1)).float()
        ctx_polarity = self.ctx_polarity_head(torch.cat([q_pool, c_pool, m_pool, ctx_probs.to(q_pool.dtype)], dim=-1)).float()

        # Solo inyectamos m_qc en q_fused cuando ctx_polarity es positiva (confirmación)
        pos_ctx_gate = F.relu(ctx_polarity) * gate_alpha
        q_fused = self.out_norm(q_tilde + lang_bias.unsqueeze(1) + 0.45 * pos_ctx_gate.to(q_tilde.dtype).unsqueeze(1) * m_qc) * q_mask.unsqueeze(-1)

        q_emb = F.normalize(self.shared_q_proj(q_fused), p=2, dim=-1)
        c_emb = F.normalize(self.shared_c_proj(c_tilde), p=2, dim=-1)
        t_emb, t_att_p, t_mask_4d = self._encode_tools_unified(
            tools_seq, t_mask, B, cand_idxs=cand_idxs, catalog_t_in=catalog_t_in, catalog_t_mask=catalog_t_mask
        )
        K = t_emb.size(1)

        # 1. Similitud Tardía Query <-> Tool (ColBERT MaxSim)
        sim_qt = torch.einsum("bqd,bktd->bkqt", q_emb, t_emb).float()
        valid_qt = (q_mask.unsqueeze(1).unsqueeze(3) * t_mask_4d.unsqueeze(2))
        sim_qt_masked = sim_qt.masked_fill(valid_qt < 0.5, -1.0)

        max_fwd, _ = sim_qt_masked.max(dim=-1)
        q_mask_bk = q_mask.unsqueeze(1).expand(B, K, Lq)
        q_len = q_mask_bk.sum(dim=-1, keepdim=True).clamp(min=1.0)
        mean_max_fwd = (max_fwd * q_mask_bk).sum(dim=-1, keepdim=True) / q_len
        top_max_fwd, _ = max_fwd.max(dim=-1, keepdim=True)
        min_max_fwd, _ = max_fwd.masked_fill(q_mask_bk < 0.5, 1.0).min(dim=-1, keepdim=True)
        cov_fwd = ((max_fwd > 0.60).float() * q_mask_bk).sum(dim=-1, keepdim=True) / q_len

        max_bwd, _ = sim_qt_masked.max(dim=-2)
        t_len = t_mask_4d.sum(dim=-1, keepdim=True).clamp(min=1.0)
        mean_max_bwd = (max_bwd * t_mask_4d).sum(dim=-1, keepdim=True) / t_len
        top_max_bwd, _ = max_bwd.max(dim=-1, keepdim=True)
        min_max_bwd, _ = max_bwd.masked_fill(t_mask_4d < 0.5, 1.0).min(dim=-1, keepdim=True)
        cov_bwd = ((max_bwd > 0.60).float() * t_mask_4d).sum(dim=-1, keepdim=True) / t_len

        # 2. Similitud Tardía Context <-> Tool con signo (Confirmación vs Corrección)
        sim_ct = torch.einsum("bcd,bktd->bkct", c_emb, t_emb).float()
        valid_ct = (c_mask.unsqueeze(1).unsqueeze(3) * t_mask_4d.unsqueeze(2))
        sim_ct_masked = sim_ct.masked_fill(valid_ct < 0.5, -1.0)

        max_ctx_fwd, _ = sim_ct_masked.max(dim=-1)
        c_mask_bk = c_mask.unsqueeze(1).expand(B, K, Lc)
        c_len = c_mask_bk.sum(dim=-1, keepdim=True).clamp(min=1.0)
        raw_ctx_fwd = (max_ctx_fwd * c_mask_bk).sum(dim=-1, keepdim=True) / c_len
        raw_ctx_top_fwd = max_ctx_fwd.max(dim=-1, keepdim=True)[0]

        max_ctx_bwd, _ = sim_ct_masked.max(dim=-2)
        raw_ctx_bwd = (max_ctx_bwd * t_mask_4d).sum(dim=-1, keepdim=True) / t_len
        raw_ctx_top_bwd = max_ctx_bwd.max(dim=-1, keepdim=True)[0]

        pol_3d = ctx_polarity.unsqueeze(1) # (B, 1, 1): +1 si confirma, -1 si corrige
        mean_ctx_fwd = pol_3d * raw_ctx_fwd
        top_ctx_fwd = pol_3d * raw_ctx_top_fwd
        mean_ctx_bwd = pol_3d * raw_ctx_bwd
        top_ctx_bwd = pol_3d * raw_ctx_top_bwd

        attn_q2t = F.softmax((sim_qt * 10.0).masked_fill(valid_qt < 0.5, -1e4), dim=-1).to(t_emb.dtype)
        q_aligned_t = torch.einsum("bkqt,bktd->bkqd", attn_q2t, t_emb)
        q_cross_pool = F.normalize((q_aligned_t * q_mask_bk.unsqueeze(-1).to(t_emb.dtype)).sum(dim=-2) / q_len.to(t_emb.dtype), p=2, dim=-1)

        attn_t2q = F.softmax((sim_qt.transpose(-1, -2) * 10.0).masked_fill(valid_qt.transpose(-1, -2) < 0.5, -1e4), dim=-1).to(q_emb.dtype)
        t_aligned_q = torch.einsum("bktq,bqd->bktd", attn_t2q, q_emb)
        t_cross_pool = F.normalize((t_aligned_q * t_mask_4d.unsqueeze(-1).to(q_emb.dtype)).sum(dim=-2) / t_len.to(q_emb.dtype), p=2, dim=-1)

        q_att_p = F.normalize(self.q_att_pool(q_emb, q_mask), p=2, dim=-1).unsqueeze(1).expand(B, K, -1)
        c_att_p = F.normalize(self.c_att_pool(c_emb, c_mask), p=2, dim=-1).unsqueeze(1).expand(B, K, -1)

        cos_qt = (q_att_p * t_att_p).sum(dim=-1, keepdim=True).float()
        cos_ct = pol_3d * (c_att_p * t_att_p).sum(dim=-1, keepdim=True).float()

        signed_ctx_weight = (gate_alpha * ctx_polarity).to(q_att_p.dtype).unsqueeze(1)
        intent_vec = F.normalize(q_att_p + 0.70 * signed_ctx_weight * c_att_p, p=2, dim=-1)

        colbert_stats = torch.cat([
            mean_max_fwd, top_max_fwd, min_max_fwd, cov_fwd,
            mean_max_bwd, top_max_bwd, min_max_bwd, cov_bwd,
            mean_ctx_fwd, top_ctx_fwd, mean_ctx_bwd, top_ctx_bwd,
            cos_qt, cos_ct,
        ], dim=-1)

        # Ancla Semántica + Penalización de Herramienta Rechazada en PREV_CORRECTION
        anchor_logit = (
            6.5 * (intent_vec.float() * t_att_p.float()).sum(dim=-1)
            + 4.5 * (mean_max_fwd.squeeze(-1) + mean_max_bwd.squeeze(-1))
            + 4.0 * gate_alpha * (mean_ctx_fwd.squeeze(-1) + mean_ctx_bwd.squeeze(-1))
            + self.colbert_linear_anchor(colbert_stats).squeeze(-1)
        )

        pair_feats = torch.cat([
            intent_vec, t_att_p, q_cross_pool, t_cross_pool,
            F.normalize(intent_vec * t_att_p, p=2, dim=-1),
            F.normalize(intent_vec - t_att_p, p=2, dim=-1),
            colbert_stats.to(intent_vec.dtype),
        ], dim=-1)

        h_base = self.pair_fusion(pair_feats)

        router_in = torch.cat([q_pool, c_pool, m_pool, lang_probs.to(q_pool.dtype), ctx_probs.to(q_pool.dtype)], dim=-1)
        router_logits = self.router(router_in).float()
        topk_vals, topk_idx = torch.topk(router_logits, k=self.top_k_experts, dim=-1)
        topk_weights = F.softmax(topk_vals, dim=-1)
        sparse_gates = torch.zeros_like(router_logits).scatter(-1, topk_idx, topk_weights)

        h_tools = self.moe_bank(h_base, topk_idx, topk_weights)
        h_diff = self.diff_injector(h_tools, cand_mask=cand_mask)

        x_set = h_diff
        for layer in self.set_layers:
            x_set = layer(x_set, cand_mask=cand_mask)
        h_refined = self.set_norm(h_diff + torch.tanh(self.set_gate) * self.set_branch_norm(x_set))
        if cand_mask is not None:
            h_refined = h_refined * cand_mask.unsqueeze(-1).to(h_refined.dtype)

        mlp_tool_logit = self.tool_logit_head(h_refined).squeeze(-1).float()
        mlp_aff_logit = self.tool_aff_head(h_refined).squeeze(-1).float()

        raw_tool_logits = 20.0 * torch.tanh((anchor_logit + 0.50 * mlp_tool_logit) / 20.0)
        raw_aff_logits = 20.0 * torch.tanh((0.75 * anchor_logit + 0.50 * mlp_aff_logit) / 20.0)

        if cand_mask is not None:
            raw_tool_logits = raw_tool_logits.masked_fill(cand_mask < 0.5, -1e4)
            tool_choice_probs = F.softmax(raw_tool_logits, dim=-1) * cand_mask
            tool_affinity_scores = torch.sigmoid(raw_aff_logits) * cand_mask
        else:
            tool_choice_probs = F.softmax(raw_tool_logits, dim=-1)
            tool_affinity_scores = torch.sigmoid(raw_aff_logits)

        return (
            m_pool, ctx_logits, ctx_probs, ctx_conf, gate_alpha, ctx_polarity,
            router_logits, sparse_gates, h_refined,
            raw_tool_logits, raw_aff_logits, tool_choice_probs, tool_affinity_scores
        )

class Capa3JevJuicioValidez(nn.Module):
    def __init__(self, d_model: int, d_out: int, dropout: float = 0.08):
        super().__init__()
        in_dim = (d_model * 3) + 16 + (d_out * 3)
        self.shared_trunk = nn.Sequential(
            nn.Linear(in_dim, 1024), nn.LayerNorm(1024), nn.GELU(), nn.Dropout(dropout),
            nn.Linear(1024, 512), nn.LayerNorm(512), nn.GELU()
        )
        self.valid_noul_head = nn.Sequential(nn.Linear(512, 128), nn.GELU(), nn.Linear(128, 1))
        self.quality_score_head = nn.Sequential(nn.Linear(512, 128), nn.GELU(), nn.Linear(128, 4))
        self.register_buffer("score_levels", torch.tensor([0.0, 1.0, 2.0, 3.0], dtype=torch.float32))

    def forward(
        self, q_pool, c_pool, m_pool, lang_probs, lang_conf, ctx_probs, ctx_conf,
        gate_alpha, h_refined, tool_choice_probs, tool_affinity_scores, cand_mask: Optional[torch.Tensor] = None
    ):
        B, K = tool_affinity_scores.shape
        if cand_mask is not None:
            k_tensor = cand_mask.sum(dim=-1, keepdim=True).clamp(min=1.0)
        else:
            k_tensor = torch.full((B, 1), float(K), device=tool_affinity_scores.device, dtype=torch.float32)

        log_k_norm = torch.log(k_tensor + 1.0) / 5.3033049
        sorted_aff, _ = torch.sort(tool_affinity_scores, dim=-1, descending=True)
        pad_zeros = torch.zeros((B, 3), device=sorted_aff.device, dtype=sorted_aff.dtype)
        padded_aff = torch.cat([sorted_aff, pad_zeros], dim=-1)
        top1_aff, top2_aff, top3_aff = padded_aff[:, 0:1], padded_aff[:, 1:2], padded_aff[:, 2:3]
        margen_12 = top1_aff - top2_aff
        top1_prob, _ = tool_choice_probs.max(dim=-1, keepdim=True)
        entropia_norm = (-torch.sum(tool_choice_probs * torch.log(tool_choice_probs.clamp(min=1e-8)), dim=-1, keepdim=True)) / torch.log(torch.clamp(k_tensor, min=2.0))

        h_ref_fp32 = h_refined.float()
        top_tool_repr = torch.sum(h_ref_fp32 * tool_choice_probs.unsqueeze(-1), dim=1)
        if cand_mask is not None:
            masked_h = h_ref_fp32.masked_fill((cand_mask < 0.5).unsqueeze(-1), -1e4)
            max_tool_feat, _ = masked_h.max(dim=1)
            mean_tool_feat = (h_ref_fp32 * cand_mask.unsqueeze(-1)).sum(dim=1) / k_tensor
        else:
            max_tool_feat, _ = h_ref_fp32.max(dim=1)
            mean_tool_feat = h_ref_fp32.mean(dim=1)

        judge_in = torch.cat([
            q_pool.float(), c_pool.float(), m_pool.float(),
            lang_probs, lang_conf, ctx_probs, ctx_conf,
            gate_alpha, top1_aff, top2_aff, top3_aff, margen_12, top1_prob, entropia_norm,
            log_k_norm, top_tool_repr, max_tool_feat, mean_tool_feat
        ], dim=-1)

        h_judge = self.shared_trunk(judge_in)
        valid_noul_logit = self.valid_noul_head(h_judge).float()
        decision_valid_noul = torch.sigmoid(valid_noul_logit)
        quality_logits = self.quality_score_head(h_judge).float()
        decision_quality_score = torch.sum(F.softmax(quality_logits, dim=-1) * self.score_levels.unsqueeze(0), dim=-1, keepdim=True)
        return decision_valid_noul, decision_quality_score, quality_logits, valid_noul_logit

class RemtkJuicioJEVMoE3_5B(nn.Module):
    def __init__(
        self, num_experts: int, top_k_experts: int, d_model: int, d_proj: int,
        d_out: int, d_exp_ffn: int, nhead: int, set_layers: int, dropout: float = 0.08, in_dim: int = E5_EMBED_DIM
    ):
        super().__init__()
        self.num_experts, self.in_dim, self.d_model = num_experts, in_dim, d_model
        self.input_adapter = nn.Sequential(
            nn.Linear(in_dim, d_model, bias=False),
            nn.LayerNorm(d_model),
        )
        self.capa1_idioma = Capa1JevIdiomaChoice(d_model=d_model, dropout=dropout)
        self.capa2_contexto_moe = Capa2JevContextoYHerramientasMoE(
            num_experts=num_experts, top_k_experts=top_k_experts, d_model=d_model,
            d_proj=d_proj, d_out=d_out, d_exp_ffn=d_exp_ffn, nhead=nhead, set_layers=set_layers, dropout=dropout
        )
        self.capa3_juicio = Capa3JevJuicioValidez(d_model=d_model, d_out=d_out, dropout=dropout)
        self.op_mode_head = nn.Sequential(nn.Linear(d_model, d_model // 2), nn.GELU(), nn.Linear(d_model // 2, 3))

    def _compute_masks(self, query_tokens, context_tokens, tools_tokens):
        q_mask = (torch.norm(query_tokens, p=2, dim=-1) > 1e-5).float()
        c_mask = (torch.norm(context_tokens, p=2, dim=-1) > 1e-5).float()
        t_mask = (torch.norm(tools_tokens, p=2, dim=-1) > 1e-5).float()
        q_mask[:, 0] = 1.0
        c_mask[:, 0] = 1.0
        if t_mask.dim() == 2:
            t_mask[:, 0] = 1.0
        else:
            t_mask[:, :, 0] = 1.0
        return q_mask, c_mask, t_mask

    def forward(self, query_tokens, context_tokens, tools_tokens, cand_idxs: Optional[torch.Tensor] = None):
        q_mask, c_mask, t_mask = self._compute_masks(query_tokens, context_tokens, tools_tokens)
        q_in = self.input_adapter(query_tokens)
        c_in = self.input_adapter(context_tokens)
        t_in = self.input_adapter(tools_tokens)

        q_tilde, c_tilde, q_pool, c_pool, _, lang_probs, lang_conf, lang_bias = self.capa1_idioma(q_in, c_in, q_mask, c_mask)
        m_pool, _, ctx_probs, ctx_conf, gate_alpha, _, _, sparse_gates, h_refined, _, _, tool_choice_probs, tool_affinity_scores = self.capa2_contexto_moe(
            q_tilde, c_tilde, q_pool, c_pool, lang_probs, lang_bias, t_in, q_mask, c_mask, t_mask, cand_mask=None, cand_idxs=cand_idxs
        )
        decision_valid_noul, decision_quality_score, _, _ = self.capa3_juicio(
            q_pool, c_pool, m_pool, lang_probs, lang_conf, ctx_probs, ctx_conf, gate_alpha, h_refined, tool_choice_probs, tool_affinity_scores, cand_mask=None
        )
        return (
            lang_probs,
            ctx_probs,
            tool_choice_probs.squeeze(0),
            tool_affinity_scores.squeeze(0),
            decision_valid_noul,
            decision_quality_score,
            sparse_gates,
        )

    def forward_train_batch(
        self, query_tokens, context_tokens, cand_mask,
        cand_idxs: torch.Tensor, catalog_tools_3d: torch.Tensor, noisy_aug: bool = False
    ):
        q_mask = (torch.norm(query_tokens, p=2, dim=-1) > 1e-5).float()
        c_mask = (torch.norm(context_tokens, p=2, dim=-1) > 1e-5).float()
        cat_t_mask = (torch.norm(catalog_tools_3d, p=2, dim=-1) > 1e-5).float()
        q_mask[:, 0] = 1.0
        c_mask[:, 0] = 1.0
        cat_t_mask[:, 0] = 1.0

        q_in = self.input_adapter(query_tokens)
        if noisy_aug and self.training:
            q_in = (q_in + torch.randn_like(q_in) * 0.02) * q_mask.unsqueeze(-1)
        c_in = self.input_adapter(context_tokens)
        cat_t_in = self.input_adapter(catalog_tools_3d)

        q_tilde, c_tilde, q_pool, c_pool, lang_logits, lang_probs, lang_conf, lang_bias = self.capa1_idioma(q_in, c_in, q_mask, c_mask)
        (
            m_pool, ctx_logits, ctx_probs, ctx_conf, gate_alpha, ctx_polarity,
            router_logits, sparse_gates, h_refined,
            raw_tool_logits, raw_aff_logits, tool_choice_probs, tool_affinity_scores
        ) = self.capa2_contexto_moe(
            q_tilde, c_tilde, q_pool, c_pool, lang_probs, lang_bias,
            tools_seq=cat_t_in, q_mask=q_mask, c_mask=c_mask, t_mask=cat_t_mask,
            cand_mask=cand_mask, cand_idxs=cand_idxs,
            catalog_t_in=cat_t_in, catalog_t_mask=cat_t_mask,
        )
        decision_valid_noul, decision_quality_score, quality_logits, valid_noul_logit = self.capa3_juicio(
            q_pool, c_pool, m_pool, lang_probs, lang_conf, ctx_probs, ctx_conf, gate_alpha,
            h_refined, tool_choice_probs, tool_affinity_scores, cand_mask=cand_mask
        )
        return {
            "q_tilde": q_tilde, "q_pool": q_pool, "lang_logits": lang_logits, "lang_probs": lang_probs,
            "ctx_logits": ctx_logits, "ctx_probs": ctx_probs, "gate_alpha": gate_alpha, "ctx_polarity": ctx_polarity,
            "router_logits": router_logits, "sparse_gates": sparse_gates, "raw_tool_logits": raw_tool_logits,
            "raw_aff_logits": raw_aff_logits, "tool_choice_probs": tool_choice_probs,
            "tool_affinity_scores": tool_affinity_scores, "decision_valid_noul": decision_valid_noul,
            "valid_noul_logit": valid_noul_logit, "decision_quality_score": decision_quality_score,
            "quality_logits": quality_logits, "op_mode_logits": self.op_mode_head(q_pool).float(),
        }


# ==============================================================================
# 4. PÉRDIDA UNIVERSAL CON SUPERVISIÓN DE POLARIDAD DE CONTEXTO
# ==============================================================================
class BatchedJevUniversalLoss(nn.Module):
    def __init__(self, num_experts: int = 128):
        super().__init__()
        self.num_experts = num_experts

    def forward(self, out: Dict[str, torch.Tensor], batch: Dict[str, torch.Tensor], out_clean: Optional[Dict[str, torch.Tensor]] = None, ema_router_load: Optional[torch.Tensor] = None):
        lang_onehot = F.one_hot(batch["lang_target"], num_classes=2).float()
        loss_capa1 = F.cross_entropy(out["lang_logits"], batch["lang_target"]) + 0.5 * F.mse_loss(out["lang_probs"], lang_onehot)

        loss_capa2_ctx = (
            F.kl_div(F.log_softmax(out["ctx_logits"], dim=-1), batch["ctx_target_dist"], reduction="batchmean")
            + 0.8 * F.cross_entropy(out["ctx_logits"], batch["ctx_int"])
            + 0.5 * F.smooth_l1_loss(out["gate_alpha"].squeeze(-1), batch["gate_target"])
            + 0.6 * F.smooth_l1_loss(out["ctx_polarity"].squeeze(-1), batch["polarity_target"])
        )

        cand_mask = batch["cand_mask"]
        raw_logits = out["raw_tool_logits"]
        raw_aff_logits = out["raw_aff_logits"]
        aff_scores = out["tool_affinity_scores"]
        t_scores = batch["t_scores"]

        pos_weight_mask = torch.where(t_scores > 0.5, 4.5, 1.0) * cand_mask
        bce_per_elem = F.binary_cross_entropy_with_logits(raw_aff_logits, t_scores, reduction="none")
        loss_bce_aff = (bce_per_elem * pos_weight_mask).sum() / pos_weight_mask.sum().clamp(min=1.0)

        has_tool = batch["has_active_tool"]
        loss_tools = loss_bce_aff

        if has_tool.any():
            act_logits = raw_logits[has_tool]
            act_aff = aff_scores[has_tool]
            act_pos_idx = batch["pos_idx"][has_tool]
            act_neg_mask = batch["neg_mask"][has_tool]

            loss_ce_choice = F.cross_entropy(act_logits, act_pos_idx, label_smoothing=0.02)

            pos_aff = act_aff.gather(1, act_pos_idx.unsqueeze(1))
            neg_affs = act_aff.masked_fill(~act_neg_mask, -1.0)
            top3_hardest_online, _ = torch.topk(neg_affs, k=min(3, neg_affs.size(1)), dim=-1)
            loss_online_margin = F.relu(0.50 - (pos_aff - top3_hardest_online)).mean()

            pos_logit = act_logits.gather(1, act_pos_idx.unsqueeze(1)).squeeze(1)
            max_neg_logit = act_logits.masked_fill(~act_neg_mask, -1e4).max(dim=-1)[0]
            loss_logit_gap = F.softplus(2.2 - (pos_logit - max_neg_logit)).mean()

            loss_tools = loss_tools + 1.4 * loss_ce_choice + 1.5 * loss_online_margin + 0.5 * loss_logit_gap

        if (~has_tool).any():
            abstain_aff = aff_scores[~has_tool]
            loss_abstain = F.relu(abstain_aff.max(dim=-1)[0] - 0.12).mean()
            loss_tools = loss_tools + 1.2 * loss_abstain

        r_probs = F.softmax(out["router_logits"], dim=-1)
        mean_r_probs = r_probs.mean(dim=0)
        valid_exp = batch["exp_target"] >= 0
        loss_moe = torch.tensor(0.0, device=raw_logits.device)
        if valid_exp.any():
            loss_moe = loss_moe + 0.20 * F.cross_entropy(out["router_logits"][valid_exp], batch["exp_target"][valid_exp])
        if ema_router_load is not None:
            loss_moe = loss_moe + 0.02 * self.num_experts * torch.sum(ema_router_load.detach() * mean_r_probs)

        noul_logit = out["valid_noul_logit"].squeeze(-1)
        p_noul = out["decision_valid_noul"].squeeze(-1).clamp(1e-6, 1.0 - 1e-6)
        y_noul = batch["y_noul"]
        pt = torch.where(y_noul >= 0.5, p_noul, 1.0 - p_noul)
        focal_bce = ((1.0 - pt) ** 2.0) * F.binary_cross_entropy_with_logits(noul_logit, y_noul, reduction="none")
        loss_capa3 = (
            1.2 * focal_bce.mean()
            + 0.8 * F.mse_loss(p_noul, y_noul)
            + 0.5 * F.cross_entropy(out["quality_logits"], batch["qual_target"])
        )

        loss_consistency = torch.tensor(0.0, device=raw_logits.device)
        if out_clean is not None:
            loss_latent_inv = (1.0 - (F.normalize(out["q_pool"], p=2, dim=-1) * F.normalize(out_clean["q_pool"].detach(), p=2, dim=-1)).sum(dim=-1)).mean()
            loss_consistency = 0.35 * loss_latent_inv

        loss_op = F.cross_entropy(out["op_mode_logits"], batch["op_target"])
        total = 0.5 * loss_capa1 + 1.2 * loss_capa2_ctx + 2.2 * loss_tools + loss_moe + 1.2 * loss_capa3 + loss_consistency + 0.3 * loss_op
        return total, mean_r_probs.detach()


# ==============================================================================
# 5. CONSTRUCCIÓN DEL DATASET CONVERSACIONAL EN VRAM (14,000 EPISODIOS)
# ==============================================================================
N_SYNTH_EPISODES = 28000
rng_synth = random.Random(SEED + 2026)
DATASET_SAMPLES = [synthesize_balanced_episode(i, rng_synth) for i in range(N_SYNTH_EPISODES)]
random.Random(SEED).shuffle(DATASET_SAMPLES)

t0 = time.perf_counter()
CLEAN_QUERY_TENSORS = encode_token_sequences([s["clean_query"] for s in DATASET_SAMPLES], prefix="query: ", max_len=MAX_QUERY_LEN, apply_canonical=True)
NOISY_QUERY_TENSORS = encode_token_sequences([s["noisy_query"] for s in DATASET_SAMPLES], prefix="query: ", max_len=MAX_QUERY_LEN, apply_canonical=True)
CONTEXT_TENSORS = encode_token_sequences([s["context"] for s in DATASET_SAMPLES], prefix="passage: ", max_len=MAX_CTX_LEN)
print(f"[Precompute E5] {len(DATASET_SAMPLES)} episodios conversacionales codificados en {time.perf_counter() - t0:.2f}s")

N_TOTAL = len(DATASET_SAMPLES)
Q_CLEAN_VRAM = CLEAN_QUERY_TENSORS.to(DEVICE, dtype=torch.float32)
Q_NOISY_VRAM = NOISY_QUERY_TENSORS.to(DEVICE, dtype=torch.float32)
C_VRAM = CONTEXT_TENSORS.to(DEVICE, dtype=torch.float32)
T_CATALOG_VRAM = CATALOG_TOOL_TENSORS.to(DEVICE, dtype=torch.float32)

CAND_IDX_VRAM = torch.zeros((N_TOTAL, MAX_CANDIDATES_K), dtype=torch.long, device=DEVICE)
CAND_MASK_VRAM = torch.zeros((N_TOTAL, MAX_CANDIDATES_K), dtype=torch.float32, device=DEVICE)
T_SCORES_VRAM = torch.zeros((N_TOTAL, MAX_CANDIDATES_K), dtype=torch.float32, device=DEVICE)
NEG_MASK_VRAM = torch.zeros((N_TOTAL, MAX_CANDIDATES_K), dtype=torch.bool, device=DEVICE)

HAS_TOOL_VRAM = torch.zeros(N_TOTAL, dtype=torch.bool, device=DEVICE)
POS_IDX_VRAM = torch.zeros(N_TOTAL, dtype=torch.long, device=DEVICE)
LANG_TARGET_VRAM = torch.zeros(N_TOTAL, dtype=torch.long, device=DEVICE)
CTX_INT_VRAM = torch.zeros(N_TOTAL, dtype=torch.long, device=DEVICE)
CTX_DIST_VRAM = torch.zeros((N_TOTAL, 4), dtype=torch.float32, device=DEVICE)
GATE_TARGET_VRAM = torch.zeros(N_TOTAL, dtype=torch.float32, device=DEVICE)
POLARITY_TARGET_VRAM = torch.zeros(N_TOTAL, dtype=torch.float32, device=DEVICE)
EXP_TARGET_VRAM = torch.full((N_TOTAL,), -1, dtype=torch.long, device=DEVICE)
Y_NOUL_VRAM = torch.zeros(N_TOTAL, dtype=torch.float32, device=DEVICE)
QUAL_TARGET_VRAM = torch.zeros(N_TOTAL, dtype=torch.long, device=DEVICE)
OP_TARGET_VRAM = torch.zeros(N_TOTAL, dtype=torch.long, device=DEVICE)

num_experts_cfg = ACTIVE_CFG["num_experts"]
for i, s in enumerate(DATASET_SAMPLES):
    cands = s["cands"][:MAX_CANDIDATES_K]
    k_len = len(cands)
    c_idxs = [tool_id_to_idx[cid] for cid in cands]
    CAND_IDX_VRAM[i, :k_len] = torch.tensor(c_idxs, dtype=torch.long, device=DEVICE)
    CAND_MASK_VRAM[i, :k_len] = 1.0
    T_SCORES_VRAM[i, :k_len] = torch.tensor(s["teacher_scores"][:k_len], dtype=torch.float32, device=DEVICE).clamp(0.0, 1.0)

    has_t = (s["target_tool"] is not None) and (k_len > 1)
    HAS_TOOL_VRAM[i] = has_t
    if has_t:
        p_idx = int(np.argmax(s["teacher_scores"][:k_len]))
        POS_IDX_VRAM[i] = p_idx
        NEG_MASK_VRAM[i, :k_len] = True
        NEG_MASK_VRAM[i, p_idx] = False

    LANG_TARGET_VRAM[i] = int(s["lang_label"])
    CTX_INT_VRAM[i] = int(s["ctx_route_label"])
    CTX_DIST_VRAM[i] = torch.tensor(s["ctx_route_probs"], dtype=torch.float32, device=DEVICE)
    GATE_TARGET_VRAM[i] = float(s["gate_target"])

    # Polaridad contextual: +1 para PREV_CONFIRM, -1 para PREV_CORRECTION, 0 para el resto
    if s["mode"] == "PREV_CONFIRM":
        POLARITY_TARGET_VRAM[i] = 1.0
    elif s["mode"] == "PREV_CORRECTION":
        POLARITY_TARGET_VRAM[i] = -1.0
    else:
        POLARITY_TARGET_VRAM[i] = 0.0

    dom_id = int(s["domain_id"])
    if dom_id >= 0 and s["target_tool"] in tool_id_to_idx:
        t_global_idx = tool_id_to_idx[s["target_tool"]]
        sub_slot = t_global_idx % (num_experts_cfg // 8)
        EXP_TARGET_VRAM[i] = (dom_id * (num_experts_cfg // 8)) + sub_slot
    Y_NOUL_VRAM[i] = float(s["valid_noul_label"])
    QUAL_TARGET_VRAM[i] = int(s["quality_level"])
    OP_TARGET_VRAM[i] = int(s.get("op_mode", 2))

def slice_vram_batch(batch_idxs: torch.Tensor) -> Dict[str, torch.Tensor]:
    return {
        "cand_idxs": CAND_IDX_VRAM[batch_idxs],
        "cand_mask": CAND_MASK_VRAM[batch_idxs],
        "t_scores": T_SCORES_VRAM[batch_idxs],
        "neg_mask": NEG_MASK_VRAM[batch_idxs],
        "has_active_tool": HAS_TOOL_VRAM[batch_idxs],
        "pos_idx": POS_IDX_VRAM[batch_idxs],
        "lang_target": LANG_TARGET_VRAM[batch_idxs],
        "ctx_int": CTX_INT_VRAM[batch_idxs],
        "ctx_target_dist": CTX_DIST_VRAM[batch_idxs],
        "gate_target": GATE_TARGET_VRAM[batch_idxs],
        "polarity_target": POLARITY_TARGET_VRAM[batch_idxs],
        "exp_target": EXP_TARGET_VRAM[batch_idxs],
        "y_noul": Y_NOUL_VRAM[batch_idxs],
        "qual_target": QUAL_TARGET_VRAM[batch_idxs],
        "op_target": OP_TARGET_VRAM[batch_idxs],
    }


