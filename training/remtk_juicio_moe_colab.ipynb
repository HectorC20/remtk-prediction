            ctx_route_probs = [0.02, 0.04, 0.91, 0.03]
            gate_target = 0.85
            valid_noul = 1.0
            quality_level = 2

        elif mode == "PREV_CORRECTION":
            pos_tid = random.choice(self.tool_ids)
            forb_tid = random.choice([t for t in self.tool_ids if t != pos_tid])
            meta = self.catalog[pos_tid]
