def install_dependencies():
    packages = [
        "torch",
        "transformers>=4.40.0",
        "datasets>=2.19.0",
        "accelerate>=0.30.0",
        "onnx>=1.16.0",
        "onnxruntime>=1.18.0",
        "safetensors>=0.4.3",
        "scikit-learn>=1.4.0",
        "matplotlib>=3.8.0",
        "tqdm>=4.66.0",
        "sentencepiece>=0.2.0",
    ]
    missing = []
    for pkg in ["torch", "transformers", "onnx", "onnxruntime", "sklearn", "matplotlib", "tqdm"]:
        try:
            __import__(pkg)
        except ImportError:
            missing.append(pkg)

    if missing:
        print(f"[Setup] Installing required packages ({', '.join(missing)})...")
        subprocess.check_call([sys.executable, "-m", "pip", "install", "-q"] + packages)
        print("[Setup] Dependencies installed successfully.")
    else:
        print("[Setup] Core dependencies already present.")

install_dependencies()

