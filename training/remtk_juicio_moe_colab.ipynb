def ensure_packages():
    missing = []
    for pkg in ["onnx", "onnxruntime", "transformers", "accelerate", "safetensors"]:
        try:
            __import__(pkg)
        except ImportError:
            missing.append(pkg)
    if missing:
        print(f"[Setup] Instalando paquetes faltantes ({', '.join(missing)})...")
        subprocess.check_call([
            sys.executable, "-m", "pip", "install", "-q",
            "onnx>=1.16.0", "onnxruntime>=1.18.0", "transformers>=4.43.0",
            "accelerate>=0.30.0", "safetensors>=0.4.3", "sentencepiece>=0.2.0"
        ])
        print("[Setup] Paquetes instalados correctamente.")

ensure_packages()

