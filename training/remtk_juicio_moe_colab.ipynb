passed = 0
for title, q, ctx, exp_lang, exp_act in verification_suite:
    res = run_jev_system_one_router(q, ctx, test_pool)
    ok_lang = (res["lang"] == exp_lang)
    ok_act = (res["final_action"] == exp_act)
