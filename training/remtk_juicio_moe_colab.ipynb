# Mapa de normalización fonética superficial para inferencia/preprocesamiento
FAST_SLANG_CANONICAL_MAP = {
    r"\bkiero\b": "quiero", r"\bkeria\b": "quería", r"\bq\b": "qué", r"\bxq\b": "porque",
    r"\bxfa\b": "por favor", r"\btmb\b": "también", r"\bpa\b": "para", r"\bd\b": "de",
    r"\bwsp\b": "whatsapp", r"\bmsj\b": "mensaje", r"\bbd\b": "base de datos",
    r"\baorita\b": "ahorita", r"\bejekutar\b": "ejecutar", r"\bejekutalo\b": "ejecútalo",
    r"\baslo\b": "hazlo", r"\bintnta\b": "intenta", r"\bbuska\b": "busca",
    r"\bbuskar\b": "buscar", r"\bcrin\s+jobs\b": "cron jobs", r"\bcrin\s+job\b": "cron job",
    r"\bherra+mientas\b": "herramientas", r"\btengp\b": "tengo", r"\btngo\b": "tengo",
    r"\bplz\b": "please", r"\brn\b": "right now", r"\bwat\b": "what", r"\babt\b": "about",
}
_COMPILED_CANONICAL_PATTERNS = [(re.compile(pat, flags=re.IGNORECASE), repl) for pat, repl in FAST_SLANG_CANONICAL_MAP.items()]

def canonicalize_chat_surface(text: str) -> str:
    out = text
    for creg, repl in _COMPILED_CANONICAL_PATTERNS:
        out = creg.sub(repl, out)
    return out


