@torch.inference_mode()
def run_quantized_jev_decision(query: str, context: str, candidate_ids: Optional[List[str]] = None) -> Dict[str, Any]:
    if candidate_ids is None:
        candidate_ids = PRODUCTION_TOOL_IDS
    c_idxs = torch.tensor([[tool_id_to_idx[tid] for tid in candidate_ids]], dtype=torch.long, device=DEVICE)
    c_mask = torch.ones((1, len(candidate_ids)), dtype=torch.float32, device=DEVICE)

    q_ten = encode_token_sequences([query], prefix="query: ", max_len=MAX_QUERY_LEN, apply_canonical=True).to(DEVICE, dtype=torch.float32)
    c_ten = encode_token_sequences([context], prefix="passage: ", max_len=MAX_CTX_LEN, apply_canonical=False).to(DEVICE, dtype=torch.float32)

    t0_inf = time.perf_counter()
    with torch.amp.autocast("cuda", dtype=torch.bfloat16, enabled=AMP_ENABLED):
        out = quant_model.forward_train_batch(q_ten, c_ten, c_mask, cand_idxs=c_idxs, catalog_tools_3d=T_CATALOG_VRAM, noisy_aug=False)
    lat_ms = (time.perf_counter() - t0_inf) * 1000.0

    ctx_probs = out["ctx_probs"][0].float().cpu().numpy()
    route_name = CONTEXT_ROUTE_LABELS[int(np.argmax(ctx_probs))]
    noul_prob = float(out["decision_valid_noul"][0, 0].float().cpu().item())
    qual_score = float(out["decision_quality_score"][0, 0].float().cpu().item())

    aff = out["tool_affinity_scores"][0].float().cpu()
    chp = out["tool_choice_probs"][0].float().cpu()
    best_tool = candidate_ids[int(torch.argmax(0.60 * aff + 0.40 * chp).item())]

    if noul_prob < 0.50 or route_name == "INDEPENDENT":
        decision = "ABSTAIN"
    elif route_name == "MEMORY":
        decision = "SELECT_MEMORY"
    else:
        decision = f"EXECUTE -> {best_tool}"

    return {"route": route_name, "noul": noul_prob, "score": qual_score, "decision": decision, "lat_ms": lat_ms}

print("\n[Audit INT8] Verificando los 12 escenarios con el modelo cuantizado INT8...")
print("=" * 132)
print(f"{'#':<3} | {'Escenario':<48} | {'Ruta':<14} | {'Noul / Score':<13} | {'Decisión INT8':<28} | {'Latencia':<8} | {'Estado'}")
print("-" * 132)
q_hits = 0
for idx_s, name, q_s, ctx_s, expected in benchmark_12:
    r = run_quantized_jev_decision(q_s, ctx_s)
    ok = (r["decision"] == expected)
    q_hits += int(ok)
    status = "✅ PASS" if ok else f"⚠️ FAIL ({expected})"
    print(f"{idx_s:<3} | {name:<48} | {r['route']:<14} | {r['noul']:.3f} / {r['score']:.1f}  | {r['decision']:<28} | {r['lat_ms']:5.1f} ms | {status}")
print("=" * 132)
print(f"[Resultado INT8 Híbrido] {q_hits}/12 escenarios aprobados ({q_hits / 12:.1%})")