]
dynamic_axes = {
    "query_tokens": {1: "q_len"},
    "context_tokens": {1: "ctx_len"},
    "tools_tokens": {0: "num_tools", 1: "tool_len"},
    "tool_choice_probs": {0: "num_tools"},
    "tool_affinity_scores": {0: "num_tools"},
