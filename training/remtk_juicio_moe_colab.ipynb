model = RemtkJuicioJEVMoE3_5B(**ACTIVE_CFG).to(DEVICE)
criterion = BatchedJevUniversalLoss(num_experts=num_experts_cfg).to(DEVICE)

total_params = sum(p.numel() for p in model.parameters())
