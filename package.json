{
  "name": "remtk-prediction",
  "version": "1.0.0",
  "description": "Tool Prediction en TypeScript: pipeline de 3 capas (keywords cross-idioma → Qdrant BM25 → umbral adaptativo) con e5-small ONNX. Usable como librería in-process o como servidor (6776/6777/6778).",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./server": {
      "types": "./dist/src/server.d.ts",
      "default": "./dist/src/server.js"
    }
  },
  "files": [
    "dist",
    "models",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "dev": "tsx src/server.ts",
    "prepublishOnly": "pnpm build",
    "test": "tsx --test tests/rerank.test.ts tests/e2e.test.ts",
    "test:all": "tsx --test tests/rerank.test.ts tests/e2e.test.ts tests/embed-model.test.ts",
    "test:model": "tsx --test tests/embed-model.test.ts",
    "test:e2e": "tsx --test tests/e2e.test.ts"
  },
  "dependencies": {
    "@huggingface/tokenizers": "^0.1.3",
    "express": "^4.21.2",
    "onnxruntime-node": "^1.20.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
