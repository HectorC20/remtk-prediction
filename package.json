{
  "name": "remtk-prediction",
  "version": "0.0.1",
  "description": "Tool Prediction en TypeScript: pipeline de 3 capas (keywords cross-idioma → Qdrant BM25 → umbral adaptativo) con e5-small ONNX. Usable como librería in-process o como servidor (6776/6777/6775).",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./server": {
      "types": "./dist/src/server.d.ts",
      "default": "./dist/src/server.js"
    }
  },
  "files": [
    "dist",
    "models",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "predev": "node scripts/ensure-qdrant.mjs",
    "dev": "tsx src/server.ts",
    "prepublishOnly": "pnpm build",
    "test": "tsx --test tests/rerank.test.ts tests/e2e.test.ts tests/graph.test.ts",
    "test:all": "tsx --test tests/rerank.test.ts tests/e2e.test.ts tests/graph.test.ts tests/embed-model.test.ts",
    "test:graph": "tsx --test tests/graph.test.ts",
    "test:model": "tsx --test tests/embed-model.test.ts",
    "test:compare": "tsx --test tests/embed-compare.test.ts",
    "test:bge": "tsx --test tests/embed-bge.test.ts",
    "test:e2e": "tsx --test tests/e2e.test.ts"
  },
  "dependencies": {
    "@huggingface/tokenizers": "^0.1.3",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "express": "^4.21.2",
    "onnxruntime-node": "^1.20.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.13",
    "typescript": "7.0.2"
  }
}
